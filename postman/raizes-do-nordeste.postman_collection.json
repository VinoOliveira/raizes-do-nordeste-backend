                  "pm.test(\"Pedido aguardando pagamento com canal e total\", () => {",
                  "    pm.expect(j.status).to.eql(\"AGUARDANDO_PAGAMENTO\");",
                  "    pm.expect(j.canalPedido).to.eql(\"TOTEM\");",
                  "    pm.expect(Number(j.total)).to.eql(25);",
                  "});",
                  "pm.collectionVariables.set(\"pedidoId\", j.pedidoId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
