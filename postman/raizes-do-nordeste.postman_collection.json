        {
          "name": "T01 - Login válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Retorna accessToken Bearer\", () => {",
                  "    pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(j.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "pm.test(\"Perfil CLIENTE e sem dados sensíveis\", () => {",
                  "    pm.expect(j.user.perfil).to.eql(\"CLIENTE\");",
                  "    pm.expect(JSON.stringify(j)).to.not.include(\"senha\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenCliente\", j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
